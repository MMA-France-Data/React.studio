# ---------------------------------------------------------------------------
# reaction-studio - configuration
# Copiez ce fichier en `.env`. Tout est optionnel : sans aucune cle, le
# pipeline tourne de bout en bout avec les providers de secours (espeak-ng
# pour la voix, un personnage placeholder pour la video).
# ---------------------------------------------------------------------------

# --- Ecriture du script de reaction (analyse video) ------------------------
# Sans cle : provider "stub", qui produit des repliques generiques calees sur
# des temps forts detectes par analyse de mouvement.
ANTHROPIC_API_KEY=
RS_VISION_PROVIDER=auto        # auto | claude | stub
RS_VISION_MODEL=claude-opus-5
RS_VISION_EFFORT=high          # low | medium | high | xhigh | max

# --- Voix ------------------------------------------------------------------
RS_TTS_PROVIDER=auto           # auto | elevenlabs | espeak
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Personnage qui reagit -------------------------------------------------
# placeholder : genere localement, sert a valider le montage et le timing.
# cmd         : delegue a votre propre commande (voir README > Providers).
RS_AVATAR_PROVIDER=placeholder # placeholder | cmd
RS_REACTOR_IMAGE=              # portrait du personnage (jpg/png), optionnel
# Commande appelee par le provider "cmd". Placeholders remplaces a l'execution :
#   {audio} {image} {out} {duration} {width} {height} {persona}
RS_AVATAR_CMD=

# Exemples fournis dans examples/providers/ :
#   still-zoom.sh   portrait fixe avec zoom lent, sans service externe
#   hedra.sh        Hedra Character-3 (necessite HEDRA_API_KEY)
#   lipsync-http.sh squelette generique pour un autre service
# Les cles de ces services se lisent dans l'environnement du script, pas ici :
#   HEDRA_API_KEY, LIPSYNC_API_URL, LIPSYNC_API_KEY

# --- Rendu -----------------------------------------------------------------
RS_WIDTH=1080
RS_HEIGHT=1920
RS_FPS=30
RS_TOP_RATIO=0.60              # part de hauteur occupee par la video source
RS_LANG=fr
RS_AI_DISCLOSURE=Contenu genere par IA
