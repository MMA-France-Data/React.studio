{
  "name": "SURVIVE-Starter-Collection",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Models": {
        "$className": "Folder",
        "Rabbit": { "$path": "models/Rabbit.rbxmx" },
        "Owl": { "$path": "models/Owl.rbxmx" },
        "Dog": { "$path": "models/Dog.rbxmx" },
        "Cat": { "$path": "models/Cat.rbxmx" },
        "Fox": { "$path": "models/Fox.rbxmx" },
        "Turtle": { "$path": "models/Turtle.rbxmx" }
      },
      "StarterAnimator": { "$path": "StarterAnimator.luau" }
