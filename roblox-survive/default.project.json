{
  "name": "Survive",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "LibraryVisuals": {
        "$className": "Folder",
        "BenchPress": { "$path": "assets/library/BenchPress.rbxmx" },
        "Treadmill": { "$path": "assets/library/Treadmill.rbxmx" },
        "Trampoline": { "$path": "assets/library/Trampoline.rbxmx" },
        "Meteor": { "$path": "assets/library/Meteor.rbxmx" },
        "Rock": { "$path": "assets/library/Rock.rbxmx" }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterUseJumpPower": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
