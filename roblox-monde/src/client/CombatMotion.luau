local ORDER = { "SlashRight", "SlashLeft" }
local Motion = { duration = 0.38 }
function Motion.variant(index: number): string
	-- Select once per observed attack; never derive parity from its timestamp.
	return ORDER[(index - 1) % #ORDER + 1]
end
function Motion.observeAttack(state, stamp: number, elapsed: number): string
	-- Do not consume a slightly future stamp before its animation can begin.
	if state.lastAttackStamp ~= stamp and elapsed >= 0 then
		state.lastAttackStamp = stamp
		if stamp > 0 and elapsed < Motion.duration then
			state.attackIndex = (state.attackIndex or 0) + 1
			state.attackName = Motion.variant(state.attackIndex)
		end
	end
	return state.attackName or ORDER[1]
end
local function cframe(value)
	if not value then return CFrame.identity end
	return CFrame.new(table.unpack(value.p)) * CFrame.Angles(table.unpack(value.r))
end
function Motion.sample(name: string, elapsed: number)
	local clip = CLIPS[name]
	assert(clip, "Clip inconnu")
	if elapsed < 0 or elapsed >= clip.duration then return nil end
	local u = elapsed / clip.duration
	for i = 2, #clip.keys do
		local b, a = clip.keys[i], clip.keys[i - 1]
		if u <= b.time then
			local t = math.clamp((u - a.time) / (b.time - a.time), 0, 1)
			local names, result = {}, {}
			for n in a.values do names[n] = true end
			for n in b.values do names[n] = true end
			for n in names do result[n] = cframe(a.values[n]):Lerp(cframe(b.values[n]), t) end
			return result
		end
	end
	return nil
end
function Motion.trail(elapsed: number): boolean
	return elapsed >= 0.076 and elapsed <= 0.296
end
function Motion.weight(elapsed: number): number
	local u = math.clamp(elapsed / Motion.duration, 0, 1)
	local t = math.min(math.clamp(u / 0.15, 0, 1), math.clamp((1 - u) / 0.16, 0, 1))
	return t * t * (3 - 2 * t)
end
return Motion
