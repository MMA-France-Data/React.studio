local Swords = {}
local Effects = require(script.Parent.SwordEffects)
local Palette = require(script.Parent.SwordPalette)
local Storage = game:GetService("ReplicatedStorage")
Swords.SIZE = 1.6
function Swords.tier(level: number): number
	return math.clamp(math.floor(level), 1, #Palette.gameOrder)
end
function Swords.dual(tier: number): boolean
	return Palette.gameOrder[Swords.tier(tier)] == "Void"
end
-- LA NOUVELLE EPEE OR (08/10) : le createur a enregistre le modele importe tel quel (« SwordGoldV2 », fichier
-- assets/swords-roblox/GoldV2.rbxm) au lieu du dossier range. Le jeu la range donc lui-meme, une seule fois, avec les
-- memes chiffres que le plugin (tools/swords/RangerLesEpees.lua, REPLACEMENTS.Gold) : elle prend la place de « Gold ».
local goldDone = false
function Swords.newGold(assets: Instance?)
	local raw = Storage:FindFirstChild("SwordGoldV2")
	if goldDone or not assets or not raw then return end
	goldDone = true
	local ok, problem = pcall(function()
		local LENGTH = 5.2
		local info = { grip = 1.040, cross = { -0.0005, 0.0421 }, base = { -0.0413, 0.0814, -0.858 }, tip = { -0.0023, 0.6570, -4.160 } }
		local model = Instance.new("Model")
		model.Name = "Gold"
		local copy = raw:Clone()
		local parts = {}
		if copy:IsA("BasePart") then table.insert(parts, copy) end
		for _, item in copy:GetDescendants() do
			if item:IsA("BasePart") then table.insert(parts, item) end
		end
		assert(#parts > 0, "aucune piece")
		table.sort(parts, function(a, b) return a.Size.Magnitude > b.Size.Magnitude end)
		local main = parts[1]
		for _, part in parts do
			part.Anchored, part.Massless = true, true
			part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
			part.Parent = model
		end
		model:ScaleTo(LENGTH / math.max(main.Size.X, main.Size.Y, main.Size.Z))
		local size, frame = main.Size, main.CFrame
		local axes = { { size.X, frame.XVector }, { size.Y, frame.YVector }, { size.Z, frame.ZVector } }
		table.sort(axes, function(a, b) return a[1] < b[1] end)
		local wide, tip = axes[2][2], axes[3][2]
		local at = main.Position - tip * (LENGTH / 2) + tip * info.grip + tip:Cross(wide) * info.cross[1] + wide * info.cross[2]
		local grip = Instance.new("Part")
		grip.Name = "Grip"
		grip.Size = Vector3.new(0.2, 0.2, 0.2)
		grip.Transparency = 1
		grip.Anchored, grip.Massless = true, true
		grip.CanCollide, grip.CanTouch, grip.CanQuery = false, false, false
		grip.CFrame = CFrame.lookAt(at, at + tip, wide)
		grip.Parent = model
		model.PrimaryPart = grip
		model:SetAttribute("Calibre", 2)
		for key, position in { TrailBase = info.base, TrailTip = info.tip } do
			local point = Instance.new("Attachment")
			point.Name, point.Position, point.Parent = key, Vector3.new(table.unpack(position)), grip
		end
		local old = assets:FindFirstChild("Gold")
		if old then old:Destroy() end
		model.Parent = assets
	end)
	if not ok then warn("[MONDE] nouvelle epee or : " .. tostring(problem)) end
end
function Swords.build(tier: number, parent: Instance): Model
	local data = DESIGNS[math.clamp(tier, 1, #DESIGNS)]
	-- Optional calibrated Meshy imports. No mesh deformation or re-generation.
	local assets = Storage:FindFirstChild("SwordMeshes")
	Swords.newGold(assets)
	-- Fire/ice fusion follows Storm. Prismatic stays outside the shop progression.
	local order = Palette.gameOrder
	local wanted = order[math.clamp(tier, 1, #order)]
	local template = assets and assets:FindFirstChild(wanted)
	if template and template:IsA("Model") and template.PrimaryPart
		and template:FindFirstChild("TrailBase", true) and template:FindFirstChild("TrailTip", true) then
		local imported = template:Clone()
		imported.Name = "Sword"
		-- (Premier rangement des epees : la prise etait posee du mauvais cote, on tenait l epee par la lame. Les
		-- modeles ranges depuis par le plugin corrige portent l attribut « Calibre » ; les autres sont retournes ici :
		-- la prise passe de l autre cote du milieu de l epee, et regarde vers la vraie pointe.)
		local hold, far = imported.PrimaryPart, imported:FindFirstChild("TrailTip", true)
		if not imported:GetAttribute("Calibre") and hold and far then
			local fromPommel = 5.2 + far.Position.Z
			hold.CFrame = hold.CFrame * CFrame.new(0, 0, -2 * (2.6 - fromPommel)) * CFrame.Angles(0, math.pi, 0)
		end
		-- DES EPEES ENORMES (sa demande : « on pourrait meme encore les grossir, qu elles soient enormes ») : SIZE fois la
		-- taille des fichiers (5,2 studs), grossies autour de la prise. La portee des coups suit (Config.ATTACK_REACH).
		imported:ScaleTo(imported:GetScale() * Swords.SIZE)
		for _, item in imported:GetDescendants() do
			if item:IsA("BasePart") then
				item.Anchored, item.Massless = true, true
				item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
			elseif item:IsA("BaseScript") or item:IsA("ModuleScript") then item:Destroy() end
		end
		imported.Parent = parent
		Effects.attach(imported, wanted)
		return imported
	end
	-- Until the new FBX has been imported in Studio, keep an existing real sword
	-- rather than masquerading an unrelated primitive fallback as the Fusion mesh.
	if wanted == "Fusion" or wanted == "Void" then
		warn("[MONDE] " .. wanted .. " absente : importer Sword_" .. wanted .. ".fbx puis enregistrer SwordMeshes.rbxm")
		return Swords.build(6, parent)
	end
	local model = Instance.new("Model")
	model.Name = "Sword"
	for _, p in data.parts do
		local part = Instance.new("Part")
		part.Name = p.name
		part.Size = Vector3.new(table.unpack(p.size))
		part.CFrame = CFrame.new(table.unpack(p.cf))
		part.Color = Color3.new(table.unpack(p.color))
		part.Material = if p.neon then Enum.Material.Neon else Enum.Material.Metal
		part.Anchored = true
		part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
		part.CastShadow = not p.neon
		part.Massless = true
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Parent = model
		if p.name == "Grip" then model.PrimaryPart = part end
	end
	assert(model.PrimaryPart, "Grip absent")
	local low, tip = Instance.new("Attachment"), Instance.new("Attachment")
	low.Name, tip.Name = "TrailBase", "TrailTip"
	low.Position, tip.Position = Vector3.new(0, 0, -0.65), Vector3.new(0, 0, data.tip)
	low.Parent, tip.Parent = model.PrimaryPart, model.PrimaryPart
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0, trail.Attachment1 = low, tip
	trail.Lifetime = 0.14
	trail.MinLength = 0.04
	trail.LightEmission, trail.LightInfluence = 1, 0
	trail.FaceCamera = true
	trail.Color = Palette.sequence(data.id)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled = false
	trail.Parent = model.PrimaryPart
	model.Parent = parent
	Effects.attach(model, data.id)
	return model
end
function Swords.setSwing(model: Model, enabled: boolean)
	Effects.update(model, 0, enabled)
end
function Swords.update(model: Model, dt: number, enabled: boolean)
	Effects.update(model, dt, enabled)
end
return Swords
