function Path.sample(variant: string, elapsed: number): CFrame
 if elapsed < 0 or elapsed >= Path.duration then return frame(REST) end
 local keys = KEYS[variant] or KEYS.SlashRight
 local u = elapsed / Path.duration
 local i = 2
 while i < #keys and keys[i].time < u do i += 1 end
 local a, b = keys[i-1], keys[i]
 local t = math.clamp((u-a.time)/(b.time-a.time), 0, 1)
 t = t*t*(3-2*t)
 return frame(a.cf):Lerp(frame(b.cf), t)
